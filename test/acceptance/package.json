{
  "author": "Seymour Pattisson <seymour.pattisson@defra.gov.uk>",
  "license": "OGL-UK-3.0",
  "name": "ffc-demo-web-acceptance-tests",
  "version": "1.1.0",
  "description": "Acceptance tests for FFC demo service",
  "homepage": "https://github.com/DEFRA/ffc-demo-acceptance-tests",
  "contributors": [
    "John Watson <john.watson2@rpa.gov.uk>",
    "Steve Hunt <steven.hunt@defra.gov.uk>",
    "Seymour Pattisson <seymour.pattisson@defra.gov.uk>"
  ],
  "keywords": [
    "wdio",
    "webdriver",
    "webdriverio",
    "cucumber",
    "test",
    "selenium"
  ],
  "scripts": {
    "test:portal": "wdio run wdio.aphw-ddi-portal.conf.js",
    "test:portal:debug": "node --inspect-brk=0.0.0.0 ./node_modules/@wdio/cli/bin/wdio.js run wdio.aphw-ddi-portal.conf.js",
    "test:enforcement": "wdio run wdio.aphw-ddi-enforcement.conf.js",
    "test:enforcement:debug": "node --inspect-brk=0.0.0.0 ./node_modules/@wdio/cli/bin/wdio.js run wdio.aphw-ddi-enforcement.conf.js",
    "test": "npm run test:portal && npm run test:enforcement",
    "test:all": "npm run test:portal && npm run test:enforcement",
    "test:debug": "npm run test:portal:debug && npm run test:enforcement:debug"
  },
  "dependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-proposal-export-default-from": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/register": "^7.28.0",
    "@cucumber/cucumber": "^13.3.0",
    "@log4js-node/log4js-api": "^1.0.2",
    "@wdio/cli": "^10.2.0",
    "@wdio/cucumber-framework": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "chai": "^4.5.0",
    "wdio-html-nice-reporter": "^8.1.7",
    "webdriverio": "^10.2.0"
  },
  "devDependencies": {
    "standard": "^17.1.2"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "standard": {
    "globals": [
      "browser",
      "it",
      "expect",
      "describe",
      "jest",
      "beforeEach",
      "assert",
      "$",
      "$$"
    ]
  }
}
